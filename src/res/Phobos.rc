#include <windows.h>
#include "../Phobos.version.h"

#define IDI_APP    100
#define ID_VERSION   1

ID_VERSION VERSIONINFO
FILEVERSION FILE_VERSION
PRODUCTVERSION FILE_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK

FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", "Phobos Minimal\0"
   VALUE "CompanyName", "The Phobos Contributors\0"
   VALUE "LegalCopyright", "� The Phobos Contributors 2026\0"
   VALUE "FileDescription", FILE_DESCRIPTION "\0"
   VALUE "FileVersion", FILE_VERSION_STR "\0"
   VALUE "ProductVersion", PRODUCT_VERSION "\0"
   VALUE "InternalName", "Phobos.dll\0"
   VALUE "OriginalFilename", "Phobos.dll\0"
  END
 END
END